[Unit]
Description=Online SQLite backup for Suno Markup Studio
After=suno.service

[Service]
Type=oneshot
User=suno
Group=suno
WorkingDirectory=/opt/suno/current
ExecStart=/bin/sh /opt/suno/current/scripts/backup-sqlite.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/suno
