# Copy to /etc/suno/suno.env on the VPS; owner root, mode 0600.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_URL=file:/var/lib/suno/suno.db
SUNO_SQLITE_DIR=/var/lib/suno
WEB_ORIGINS=https://YOUR_SERVER_IP
WRITE_ORIGIN_PROTECTION=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_PATH=/suno/api
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=2592000000
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_MS=900000
